{
  "name": "kryvex",
  "productName": "Kryvex",
  "version": "0.9.5-hotfix.7",
  "description": "A modular desktop workspace that brings independent web services, a browser and shared tools into one engineered surface.",
  "license": "MIT",
  "author": {
    "name": "XiØN",
    "url": "https://github.com/XiONDiGiTaL"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiONDiGiTaL/Kryvex.git"
  },
  "homepage": "https://github.com/XiONDiGiTaL/Kryvex",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev.mjs",
    "build": "node scripts/check-brand-icons.cjs && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "build:web": "vite build --outDir dist-web && node scripts/check-brand-icons.cjs && node scripts/check-web-build.cjs",
    "capture": "node scripts/capture.mjs",
    "check:icons": "node scripts/check-brand-icons.cjs",
    "audit:deps": "node scripts/audit-deps.cjs",
    "audit:i18n": "node scripts/audit-i18n.cjs",
    "fetch:runtime": "node scripts/fetch-runtime.mjs",
    "package:dir": "node scripts/fetch-runtime.mjs && pnpm build && electron-builder --dir",
    "package:win": "node scripts/fetch-runtime.mjs && pnpm build && electron-builder --publish never",
    "release:checksums": "node scripts/release-checksums.cjs",
    "release:wizard": "node scripts/verify-self-update.cjs --wizard --archive",
    "release:check": "node scripts/check-release-record.cjs",
    "verify:restart": "pnpm build && node scripts/verify-restart.cjs",
    "verify:downloads": "pnpm build && electron scripts/verify-download-history.cjs",
    "verify:location-ui": "pnpm build && node scripts/verify-download-location-ui.cjs",
    "verify:torrents": "pnpm build && node scripts/verify-torrents.cjs",
    "verify:torrent-restore-ui": "pnpm build && node scripts/verify-torrent-restore-ui.cjs",
    "verify:browser": "pnpm build && node scripts/verify-browser-tools.cjs",
    "verify:browser-start": "pnpm build && node scripts/verify-browser-start.cjs",
    "verify:popups": "pnpm build && node scripts/verify-popup-tabs.cjs",
    "verify:services": "pnpm build && node scripts/verify-service-engine.cjs",
    "verify:otp": "pnpm build && node scripts/verify-one-time-code.cjs",
    "verify:chromium": "pnpm build && node scripts/verify-chromium-settings.cjs",
    "verify:updater": "pnpm build && node scripts/verify-updater.cjs",
    "verify:self-update": "node scripts/verify-self-update.cjs",
    "verify:rooms": "pnpm build && node scripts/verify-rooms.cjs",
    "verify:gallery": "pnpm build && node scripts/verify-theme-gallery.cjs",
    "verify:layout": "pnpm build && node scripts/verify-layout.cjs",
    "verify:wallpaper": "pnpm build && node scripts/verify-wallpaper-ui.cjs",
    "verify:identity": "pnpm build && electron scripts/verify-browser-identity.cjs",
    "verify:google": "pnpm build && electron scripts/verify-google-signin.cjs",
    "verify:identity-matrix": "pnpm build && electron scripts/verify-identity-matrix.cjs",
    "verify:shield-filters": "pnpm build && electron scripts/verify-shield-filters.cjs",
    "verify:service-ux": "pnpm build && node scripts/verify-service-ux.cjs",
    "verify:signin-fold": "pnpm build && node scripts/verify-service-signin-fold.cjs",
    "verify:model": "pnpm build && electron scripts/verify-local-model.cjs",
    "verify:lexium-speech": "pnpm build && node scripts/verify-lexium-speech.cjs",
    "verify:speech": "pnpm build && node scripts/verify-speech-runtime.cjs",
    "verify:speech-bridge": "pnpm build && node scripts/verify-speech-bridge.cjs",
    "verify:packaged-startup": "node scripts/verify-packaged-startup.cjs",
    "verify:lexium-language": "pnpm build && node scripts/verify-lexium-language.cjs",
    "verify:disk": "pnpm build && node scripts/verify-disk-pulse.cjs",
    "verify:party-close": "pnpm build && node scripts/verify-party-close.cjs",
    "verify:guards": "pnpm build && node scripts/verify-window-guards.cjs",
    "audit:lifecycle": "node scripts/audit-lifecycle.cjs",
    "art:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/installer-art.ps1",
    "verify:link": "pnpm build && node scripts/verify-link.cjs",
    "verify:home-tools": "node scripts/verify-home-tools.cjs",
    "verify:capture-window": "node scripts/verify-capture-window.cjs",
    "verify:canvas": "node scripts/verify-workspace-placement.cjs",
    "verify:room-window": "pnpm build && node scripts/verify-room-window.cjs",
    "verify:inhouse": "pnpm build && node scripts/verify-inhouse-services.cjs",
    "verify:shell-batch": "pnpm build && node scripts/verify-shell-batch.cjs",
    "verify:batch": "pnpm build && node scripts/verify-batch.cjs",
    "verify:vlan": "node scripts/verify-vlan.cjs",
    "verify:flycast": "electron scripts/verify-flycast.cjs",
    "verify:netplay": "electron scripts/verify-netplay.cjs",
    "verify:couch": "pnpm build && node scripts/verify-couch-coop.cjs"
  },
  "build": {
    "appId": "net.xiondigital.kryvex",
    "productName": "Kryvex",
    "icon": "brand/icons/kryvex.ico",
    "artifactName": "Kryvex-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "brand"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/node-datachannel/**/*"
    ],
    "extraResources": [
      {
        "from": "brand/icons",
        "to": "icons"
      },
      {
        "from": "runtime/bin",
        "to": "bin"
      }
    ],
    "win": {
      "icon": "brand/icons/kryvex.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Kryvex-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kryvex",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "uninstallDisplayName": "Kryvex ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Kryvex-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "@trystero-p2p/torrent": "0.26.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "simple-icons": "^16.35.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
