{
  "name": "kryvex",
  "productName": "Kryvex",
  "version": "0.3.0",
  "description": "A modular desktop workspace that brings independent web services, a browser and shared tools into one engineered surface.",
  "license": "MIT",
  "author": {
    "name": "XiØN",
    "url": "https://github.com/XiONDiGiTaL"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiONDiGiTaL/Kryvex.git"
  },
  "homepage": "https://github.com/XiONDiGiTaL/Kryvex",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev.mjs",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "capture": "node scripts/capture.mjs",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:win": "pnpm build && electron-builder"
  },
  "build": {
    "appId": "net.xiondigital.kryvex",
    "productName": "Kryvex",
    "artifactName": "Kryvex-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "brand"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "brand/icons",
        "to": "icons"
      }
    ],
    "win": {
      "icon": "brand/icons/kryvex.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Kryvex-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kryvex",
      "uninstallDisplayName": "Kryvex ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Kryvex-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "extract-zip": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "simple-icons": "^16.35.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
