{
  "name": "kryvex",
  "productName": "Kryvex",
  "version": "0.8.0",
  "description": "A modular desktop workspace that brings independent web services, a browser and shared tools into one engineered surface.",
  "license": "MIT",
  "author": {
    "name": "XiØN",
    "url": "https://github.com/XiONDiGiTaL"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiONDiGiTaL/Kryvex.git"
  },
  "homepage": "https://github.com/XiONDiGiTaL/Kryvex",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev.mjs",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "capture": "node scripts/capture.mjs",
    "audit:i18n": "node scripts/audit-i18n.cjs",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:win": "pnpm build && electron-builder --publish never",
    "release:checksums": "node scripts/release-checksums.cjs",
    "verify:restart": "pnpm build && node scripts/verify-restart.cjs",
    "verify:downloads": "pnpm build && electron scripts/verify-download-history.cjs",
    "verify:location-ui": "pnpm build && node scripts/verify-download-location-ui.cjs",
    "verify:torrents": "pnpm build && node scripts/verify-torrents.cjs",
    "verify:torrent-restore-ui": "pnpm build && node scripts/verify-torrent-restore-ui.cjs",
    "verify:browser": "pnpm build && node scripts/verify-browser-tools.cjs",
    "verify:services": "pnpm build && node scripts/verify-service-engine.cjs",
    "verify:chromium": "pnpm build && node scripts/verify-chromium-settings.cjs",
    "verify:updater": "pnpm build && node scripts/verify-updater.cjs",
    "verify:rooms": "pnpm build && node scripts/verify-rooms.cjs",
    "verify:gallery": "pnpm build && node scripts/verify-theme-gallery.cjs",
    "verify:layout": "pnpm build && node scripts/verify-layout.cjs",
    "verify:wallpaper": "pnpm build && node scripts/verify-wallpaper-ui.cjs",
    "verify:identity": "pnpm build && electron scripts/verify-browser-identity.cjs",
    "verify:shield-filters": "pnpm build && electron scripts/verify-shield-filters.cjs",
    "verify:model": "pnpm build && electron scripts/verify-local-model.cjs",
    "verify:party-close": "pnpm build && node scripts/verify-party-close.cjs"
  },
  "build": {
    "appId": "net.xiondigital.kryvex",
    "productName": "Kryvex",
    "artifactName": "Kryvex-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "brand"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/node-datachannel/**/*"
    ],
    "extraResources": [
      {
        "from": "brand/icons",
        "to": "icons"
      }
    ],
    "win": {
      "icon": "brand/icons/kryvex.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Kryvex-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kryvex",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "Kryvex ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Kryvex-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "@trystero-p2p/torrent": "0.26.0",
    "extract-zip": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "simple-icons": "^16.35.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
